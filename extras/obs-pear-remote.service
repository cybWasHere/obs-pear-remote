# Optional: serve the widgets at login. Assumes the repo is cloned to ~/obs-pear-remote; if not,
# fix both paths on the ExecStart line. Copy to ~/.config/systemd/user/, then:
#   systemctl --user enable --now obs-pear-remote
[Unit]
Description=Serve the OBS Pear remote on 127.0.0.1:9870 (loopback only)

[Service]
ExecStart=/usr/bin/python3 %h/obs-pear-remote/extras/serve.py 9870 --bind 127.0.0.1 --directory %h/obs-pear-remote
Restart=on-failure

[Install]
WantedBy=default.target
