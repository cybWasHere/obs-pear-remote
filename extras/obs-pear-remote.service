# Optional: serve the widgets at login. Copy to ~/.config/systemd/user/, fix the --directory
# path if you cloned elsewhere, then: systemctl --user enable --now obs-pear-remote
[Unit]
Description=Serve the OBS Pear remote on 127.0.0.1:9870 (loopback only)

[Service]
ExecStart=/usr/bin/python3 -m http.server 9870 --bind 127.0.0.1 --directory %h/claude/projects/obs-pear-remote
Restart=on-failure

[Install]
WantedBy=default.target
